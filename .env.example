# ---- MQTT (EMQX) ----
# Credentials for device/app MQTT clients, registered by emqx-auth-init.
MQTT_USERNAME=pulsepipe
MQTT_PASSWORD=change-me-strong-password
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083

# ---- Kafka ----
# Host port of the EXTERNAL listener (advertised as localhost:<port>).
KAFKA_EXTERNAL_PORT=29092

# ---- TimescaleDB ----
POSTGRES_USER=pulsepipe
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=pulsepipe
TIMESCALEDB_PORT=5432

# ---- RustFS (S3-compatible object storage) ----
RUSTFS_ACCESS_KEY=pulsepipe
RUSTFS_SECRET_KEY=change-me-rustfs-secret
STORAGE_BUCKET=pulsepipe
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001
