# Normalize all text files to LF in the repository; Git Bash / Docker tooling expects LF.
* text=auto eol=lf

# Source code
*.java text diff=java
*.xml text
*.yml text
*.yaml text
*.properties text
*.sql text
*.sh text eol=lf
*.md text

# Windows-only scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.ttf binary
